{
  "realm": "slm-forge",
  "enabled": true,
  "displayName": "SLM-Forge",
  "displayNameHtml": "SLM-Forge",
  "accessTokenLifespan": 3600,
  "accessTokenLifespanForImplicitFlow": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "offlineSessionIdleTimeout": 2592000,
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "rememberMe": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 30,
  "defaultSignatureAlgorithm": "RS256",
  "revokeRefreshToken": false,
  "refreshTokenMaxReuse": 0,
  "requiredCredentials": ["password"],
  "passwordPolicy": "length(8)",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyPeriod": 30,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Full CRUD across all SLM-Forge resources. Use sparingly."
      },
      {
        "name": "data_engineer",
        "description": "Owns datasets, experiments, and runs. Can trigger exports."
      },
      {
        "name": "domain_expert",
        "description": "Read-only on technical artifacts; authors research reports and chats."
      },
      {
        "name": "devops",
        "description": "Manages logs and system settings. Read-only on training artifacts."
      },
      {
        "name": "operations",
        "description": "Day-to-day runtime ops: reads everything, can execute exports."
      },
      {
        "name": "support",
        "description": "Read-only across the board for customer/internal support staff."
      }
    ]
  },
  "users": [
    {
      "username": "admin@local",
      "email": "admin@local",
      "firstName": "Local",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": ["admin"]
    },
    {
      "username": "engineer@local",
      "email": "engineer@local",
      "firstName": "Local",
      "lastName": "Engineer",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "engineer",
          "temporary": false
        }
      ],
      "realmRoles": ["data_engineer"]
    }
  ],
  "clients": [
    {
      "clientId": "slm-forge-web",
      "name": "SLM-Forge Web UI",
      "description": "Public client used by the React SPA running on :5173.",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##http://127.0.0.1:5173/*"
      },
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "web-origins",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    },
    {
      "clientId": "slm-forge-api",
      "name": "SLM-Forge API",
      "description": "Bearer-only client used by the FastAPI backend to validate access tokens.",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "web-origins",
        "profile",
        "roles",
        "email"
      ]
    }
  ],
  "browserSecurityHeaders": {
    "contentSecurityPolicy": "frame-src 'self'; frame-ancestors 'self'; object-src 'none';",
    "xContentTypeOptions": "nosniff",
    "xRobotsTag": "none",
    "xFrameOptions": "SAMEORIGIN",
    "strictTransportSecurity": "max-age=31536000; includeSubDomains"
  },
  "smtpServer": {},
  "internationalizationEnabled": false,
  "supportedLocales": [],
  "defaultLocale": ""
}
