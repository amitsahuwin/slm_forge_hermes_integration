# SLM-Forge runtime config. Copy to .env and edit as needed.
# .env is auto-loaded by host workers (make trainer / ratchet / exporter)
# and by docker-compose for the API + UI + Keycloak + OPA + MCP containers.
#
# Default values are chosen so a fresh `make dev` + `make trainer / ratchet /
# exporter` works on a single Mac. Override below for production deployments.

# ─── Hermes / Ollama ────────────────────────────────────────────────────────
# Where the host workers reach Ollama. Inside Docker, the API container uses
# `host.docker.internal` (wired via docker-compose.yml, do not edit here).
OLLAMA_URL=http://localhost:11434

# Which Ollama model the Hermes ratchet + skill endpoints use.
#   qwen3:30b-a3b      — 30B MoE (~3B active), best reasoning, ~18GB RAM
#   qwen2.5-coder:14b  — 14B dense, ~9GB RAM
#   qwen2.5-coder:7b   — 7B dense, ~5GB RAM (lightest)
#   llama3.1:8b        — 8B dense general-purpose
HERMES_MODEL=gemma4:latest
# HERMES_MODEL=qwen3:30b-a3b

# Chat-page model. Defaults to HERMES_MODEL when unset.
# Set to a smaller model (e.g. qwen2.5:7b) for snappier chat responses.
# CHAT_MODEL=qwen2.5:7b

# Where Hermes skill markdowns live. The repo's ./.hermes-skills/ is bind-
# mounted at /app/.hermes-skills inside the API container.
# HERMES_SKILLS_DIR=~/.hermes/skills

# ─── Hermes bridge — PR-1 hardening (retries · A2 fail-loud · A3 redact · A4 tenant) ─
# A1: retry transient Ollama failures (ConnectError, ReadTimeout, 429/502/503/504)
# with exponential backoff + jitter. ``HERMES_MAX_RETRIES=1`` disables retry.
HERMES_MAX_RETRIES=3
HERMES_OLLAMA_TIMEOUT_S=300
HERMES_RETRY_BACKOFF_MULT_S=0.5
# A2: maximum consecutive ``MutationProposalError`` before the ratchet aborts
# the session. Was a silent fabrication before; now visibly fails after N tries.
HERMES_MAX_PROPOSAL_FAILURES=3
# A3: never emit response bodies to logs by default (developer opt-in only).
HERMES_LOG_PAYLOADS=false
# A3: persist request/response JSON in HermesTrace rows for the admin trace UI.
# Set false to blank ALL bodies (privacy-strict deployments).
HERMES_TRACE_STORE_PAYLOADS=true
# A3: comma-separated source labels whose bodies are always redacted in the
# trace table — these sources routinely carry user dataset content.
HERMES_TRACE_REDACT_SOURCES=skill:dataset_synth,skill:ingest_dataset,skill:auto_label_unlabeled,skill:data_quality_review
# A4: tenant boundary on HermesTrace. ``SLM_FORGE_TENANT_ID`` is the per-worker
# override; ``SLM_FORGE_DEFAULT_TENANT`` is the process-wide fallback. Single-
# tenant deployments leave both at ``default``.
# SLM_FORGE_TENANT_ID=
SLM_FORGE_DEFAULT_TENANT=default

# ─── PR-2: auto post-mortem on run failure ────────────────────────────────
# On every PATCH /runs/{id} transition into status=failed, the API enqueues a
# BackgroundTask that runs the `failure_post_mortem` Hermes skill and stores
# the markdown on the Run row (+ a sidecar file at runs/<id>/post_mortem.md).
HERMES_POST_MORTEM_ENABLED=true
# Cap concurrent skill invocations from the post-mortem service so a failure
# storm doesn't saturate Ollama. Applies process-wide (per API worker).
HERMES_MAX_CONCURRENT=2

# ─── PR-3: plain-English remedy on 4xx errors ─────────────────────────────
# Catalog-rejected runs and synth-router 4xx errors get a 1-3 sentence remedy
# generated by the `error_remedy` Hermes skill, attached as `detail.remedy`.
# Hermes outages and timeouts fall back to `remedy=null` — the original 4xx
# is still returned promptly.
HERMES_REMEDY_ENABLED=true
# Hard cap on the LLM call's wall-time. Keep tight: this runs inline in the
# user's failing request.
HERMES_REMEDY_TIMEOUT_S=4

# ─── API + worker plumbing ─────────────────────────────────────────────────
# URL workers POST to. Keep "localhost" here — workers run on the host.
SLM_FORGE_API_URL=http://localhost:8000

# How often workers poll for queued jobs (seconds).
SLM_FORGE_POLL_INTERVAL=2.0

# Which training backend this trainer worker runs (Phase O).
# `mlx`  → mlx-lm on Apple Silicon (default; host process, needs Metal).
# `cuda` → arrives in Phase Q (PEFT + TRL on NVIDIA GPUs).
SLM_FORGE_TRAINER_BACKEND=mlx

# Reject runs whose base_model isn't in the model catalog (Phase P).
# Set to false to fine-tune arbitrary HF checkpoints at your own risk.
SLM_FORGE_ENFORCE_CATALOG=true

# Remote worker mode (Phase R). When true, the trainer downloads dataset
# archives from the API and uploads adapters back — no shared filesystem
# needed. Leave false on the Mac (local paths are the fast path).
# SLM_FORGE_REMOTE_WORKER=false

# Claim lease (Phase R): a running run with no metric activity for this many
# minutes is considered abandoned and re-queued for another worker.
# SLM_FORGE_CLAIM_TIMEOUT_MIN=60

# CUDA backend quantization for base-model loading (Phase Q).
# `nf4` (default) → bitsandbytes 4-bit QLoRA. `none` → full-precision LoRA.
# SLM_FORGE_CUDA_QUANT=nf4

# Hugging Face token for gated models (Gemma / Llama / Mistral downloads).
# NEVER commit a real token. Prefer `huggingface-cli login` on dev machines;
# set this only for headless CUDA workers (docker run -e HF_TOKEN=...).
# HF_TOKEN=

# ─── Logging (Phase L) ─────────────────────────────────────────────────────
# `json` → structured logs to runs/_<worker>.log.json (Loki / Grafana ready).
# `text` → plain text to runs/_<worker>.log (readable in the terminal).
# Set by `make trainer / ratchet / exporter` automatically — change here for
# any process you start manually.
SLM_FORGE_LOG_FORMAT=json

# ─── Authentication (Phase M) ──────────────────────────────────────────────
# Default ON. To revert to the legacy single-user dev workflow (no JWT, no
# OPA, every request gets the synthetic admin), set to false.
SLM_FORGE_AUTH_ENABLED=true

# Where the API container reaches Keycloak (Docker DNS, internal).
KEYCLOAK_URL=http://keycloak:8080
# Where the BROWSER reaches Keycloak (host-facing). The /api/v1/auth/config
# endpoint returns this URL to the SPA so it can redirect to login —
# `keycloak:8080` won't resolve from the user's browser.
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_REALM=slm-forge
KEYCLOAK_WEB_CLIENT_ID=slm-forge-web

# Where the API consults OPA for policy decisions.
OPA_URL=http://opa:8181

# Fallback user attached when auth is DISABLED. Has full admin in dev.
SLM_FORGE_DEFAULT_USER=anonymous

# Service-account shared secret. The host workers (trainer / ratchet /
# exporter) attach this to every API request as `X-Service-Token`. The
# AuthMiddleware short-circuits past JWT validation + OPA when the token
# matches. CHANGE this in any non-local deployment.
# Generate a fresh value with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SLM_FORGE_SERVICE_TOKEN=i9kcuskH9cXtYQIiYjkkdOpFBCLAoWieNqfv8ON4Pkg

# ─── R&D web search (Phase K.2) ────────────────────────────────────────────
# Free DuckDuckGo (ddgs package) is used by default. Setting either of these
# unlocks the corresponding higher-quality backend automatically.
# SERPAPI_KEY=
# TAVILY_API_KEY=

# ─── Observability (Phase L) ───────────────────────────────────────────────
# Default port for Grafana when the obs overlay is up.
# GRAFANA_PORT=3001

# ─── MCP server (Claude Desktop / Cursor / Claude Code) ────────────────────
# HTTP transport port for the MCP container. Stdio transport (Claude Desktop)
# uses the host process directly — no env needed.
# MCP_PORT=8765

# Hugging Face token
HF_TOKEN=

DEPLOYMENT_MODE=development  # production/development

# Anthropic API key (Ollama)
ANTHROPIC_BASE_URL="http://localhost:11434"
ANTHROPIC_AUTH_TOKEN="ollama"
ANTHROPIC_API_KEY="ollama" 