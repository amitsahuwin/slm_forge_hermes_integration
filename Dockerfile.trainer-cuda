# Phase Q — CUDA trainer worker image (A100 / any NVIDIA GPU).
#
# Build:
#   docker build -f Dockerfile.trainer-cuda -t slm-forge-trainer-cuda .
#
# Run (worker polls the API; all file movement assumes a shared volume
# until Phase R adds transfer endpoints):
#   docker run --gpus all \
#     -e SLM_FORGE_API_URL=http://<api-host>:8000 \
#     -e SLM_FORGE_SERVICE_TOKEN=<token> \
#     -e HF_TOKEN=<hf token>            # never bake into the image \
#     -v $(pwd)/data:/app/data -v $(pwd)/runs:/app/runs \
#     slm-forge-trainer-cuda
FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    SLM_FORGE_TRAINER_BACKEND=cuda \
    SLM_FORGE_LOG_FORMAT=json

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.12 python3.12-venv python3-pip git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Project metadata first for layer caching, then sources.
COPY pyproject.toml README.md ./
COPY packages ./packages
COPY apps/api ./apps/api

RUN python3.12 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir -U pip \
    && /opt/venv/bin/pip install --no-cache-dir -e ".[trainer-cuda]"

ENV PATH="/opt/venv/bin:$PATH"

# The worker loop is backend-agnostic; SLM_FORGE_TRAINER_BACKEND=cuda makes
# it train with PEFT + TRL + bitsandbytes.
CMD ["python", "-m", "packages.trainer"]
