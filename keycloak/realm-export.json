{
  "realm": "slm-forge",
  "enabled": true,
  "displayName": "SLM-Forge",
  "displayNameHtml": "SLM-Forge",
  "accessTokenLifespan": 3600,
  "accessTokenLifespanForImplicitFlow": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "offlineSessionIdleTimeout": 2592000,
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "rememberMe": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 30,
  "defaultSignatureAlgorithm": "RS256",
  "revokeRefreshToken": false,
  "refreshTokenMaxReuse": 0,
  "requiredCredentials": [
    "password"
  ],
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyPeriod": 30,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Full CRUD across all SLM-Forge resources. Use sparingly."
      },
      {
        "name": "data_engineer",
        "description": "Owns datasets, experiments, and runs. Can trigger exports."
      },
      {
        "name": "domain_expert",
        "description": "Read-only on technical artifacts; authors research reports and chats."
      },
      {
        "name": "devops",
        "description": "Manages logs and system settings. Read-only on training artifacts."
      },
      {
        "name": "operations",
        "description": "Day-to-day runtime ops: reads everything, can execute exports."
      },
      {
        "name": "support",
        "description": "Read-only across the board for customer/internal support staff."
      },
      {
        "name": "viewer",
        "description": "Phase C — read-only baseline used for users without a stronger role."
      },
      {
        "name": "worker",
        "description": "Phase C — service accounts for trainer/ratchet/exporter. Narrow scope: claim_run, update_run, upload_artifact, read_dataset."
      }
    ]
  },
  "groups": [
    {
      "name": "tenants",
      "path": "/tenants",
      "subGroups": [
        {"name": "local", "path": "/tenants/local"},
        {"name": "acme", "path": "/tenants/acme"},
        {"name": "globex", "path": "/tenants/globex"},
        {"name": "system", "path": "/tenants/system"}
      ]
    }
  ],
  "defaultGroups": ["/tenants/local"],
